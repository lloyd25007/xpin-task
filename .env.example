# =============================================================================
# GraphRAG — configuration template.  template. Copy to .env and fill in the blanks.
# =============================================================================

# ---- Neo4j (Aura) ----
# Scheme is neo4j+ssc:// (encrypted, certificate NOT verified) rather than
# neo4j+s://, because this network runs a TLS-intercepting proxy whose
# self-signed root breaks certificate validation. Traffic is still encrypted.
# On a network without interception, switch back to neo4j+s://.
NEO4J_URI=neo4j+ssc://00a8bd72.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Primary provider, then the chain tried when it errors (402, 429, outage).
# =============================== LLM =========================================
# Any OpenAI-compatible provider. Only the key, base URL and model id differ.

# Primary provider, then the chain tried when it errors (402, 429, outage).
# Providers without a key are skipped automatically.
LLM_PROVIDER=requesty
LLM_FALLBACK_PROVIDERS=openrouter

# ---- Provider credentials (set at least one) ----
REQUESTY_API_KEY=
OPENROUTER_API_KEY=

# OpenAI is supported but not configured here. To use it, set LLM_PROVIDER=openai
# and uncomment:
# OPENAI_API_KEY=

# ---- Provider endpoints ----
REQUESTY_BASE_URL=https://router.requesty.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Model ----
# Must support tool calling: graph extraction relies on structured output.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Per-provider overrides, for when the same model is published under different
# ids. Leave blank to use LLM_MODEL. OpenRouter's free tier, for example, needs
# a ":free" suffix that Requesty does not use:
#   LLM_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_REQUESTY=
LLM_MODEL_OPENROUTER=
LLM_MODEL_OPENAI=

# Cap on generated tokens. Worth setting: with no cap, OpenRouter prices a
# request against the model's full context window and rejects it on a low
# balance, even when the answer is two lines long.
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.0

# Model-level fallback *within* OpenRouter (its "models" array, max 3 entries).
# Ignored by other providers; cross-provider failover is LLM_FALLBACK_PROVIDERS.
LLM_FALLBACK_MODELS=

# Point at any other OpenAI-compatible endpoint, e.g. a local Ollama server.
# These override the provider-specific values above when set.
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1

# ---- Extraction throughput (free-tier models rate-limit hard) ----
EXTRACTION_WORKERS=8
EXTRACTION_RPM=30

# ---- Embeddings (runs locally, no API key needed) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Chunking (token counts, measured with tiktoken) ----
PARENT_CHUNK_TOKENS=1000
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_TOKENS=200
CHILD_CHUNK_OVERLAP=40

# ---- Reranker (cross-encoder, runs locally) ----
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true

# ---- Router / fusion ----
# ROUTING_MODE: llm | heuristic | hybrid
ROUTING_MODE=llm
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_GRAPH_WEIGHT=0.8

# ---- Retrieval ----
VECTOR_TOP_K=12
PARENT_TOP_N=5
GRAPH_MAX_HOPS=2
GRAPH_MAX_TRIPLES=40
# ---- Paths ----
DATA_DIR=data
# Load the bundled .cypher into Neo4j on startup when the graph is empty.
# Never overwrites an existing graph; set false to disable.
GRAPH_BOOTSTRAP=true
GRAPH_BOOTSTRAP_FILE=emirates_nbd_graph.cypher

DOCS_DIR=Company Docs
DEFAULT_PDF_PATH=Company Docs/strategic_report_2025_emirates_nbd.pdf

# ---- UI ----
API_BASE_URL=http://localhost:8000
